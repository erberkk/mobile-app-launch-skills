<?xml version="1.0" encoding="UTF-8"?>
<!--
  Only canonical, indexable URLs that return 200. No /i/ invite pages, no token pages, no redirects.
  lastmod = date the page content last changed (e.g. last git commit touching its sources), not the build time.
  Each language version lists every version including itself, plus x-default (same set as the page's <link rel="alternate">).
  Protocol: https://www.sitemaps.org/protocol.html
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://example.com/</loc>
    <lastmod>2026-01-15</lastmod>
    <xhtml:link rel="alternate" hreflang="en" href="https://example.com/"/>
    <xhtml:link rel="alternate" hreflang="de" href="https://example.com/de"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://example.com/"/>
  </url>
  <url>
    <loc>https://example.com/de</loc>
    <lastmod>2026-01-15</lastmod>
    <xhtml:link rel="alternate" hreflang="en" href="https://example.com/"/>
    <xhtml:link rel="alternate" hreflang="de" href="https://example.com/de"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://example.com/"/>
  </url>
  <url>
    <loc>https://example.com/privacy</loc>
    <lastmod>2026-01-10</lastmod>
    <xhtml:link rel="alternate" hreflang="en" href="https://example.com/privacy"/>
    <xhtml:link rel="alternate" hreflang="de" href="https://example.com/de/privacy"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://example.com/privacy"/>
  </url>
  <url>
    <loc>https://example.com/de/privacy</loc>
    <lastmod>2026-01-10</lastmod>
    <xhtml:link rel="alternate" hreflang="en" href="https://example.com/privacy"/>
    <xhtml:link rel="alternate" hreflang="de" href="https://example.com/de/privacy"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://example.com/privacy"/>
  </url>
  <!-- A page with one language only: no xhtml:link lines needed. -->
  <url>
    <loc>https://example.com/terms</loc>
    <lastmod>2026-01-10</lastmod>
  </url>
  <url>
    <loc>https://example.com/support</loc>
    <lastmod>2026-01-10</lastmod>
  </url>
  <url>
    <loc>https://example.com/delete-account</loc>
    <lastmod>2026-01-10</lastmod>
  </url>
</urlset>
